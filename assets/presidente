(function(){
  const app = document.getElementById("app");
  const nav = document.querySelectorAll(".navItem");

  // Flags demo (en la app real esto vendrá de localStorage/informes)
  let requiresNewReport = true;

  function renderHome(){
    app.innerHTML = `
      <div class="card">
        <div class="kTitle">Estado general del curso</div>
        <div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap;">
          <span class="pill ok">💰 Recaudado $250.000</span>
          <span class="pill warn">🧾 Gastado $120.000</span>
          <span class="pill">⚖️ Saldo $130.000</span>
          <span class="pill warn">⏳ Adeudado curso $40.000</span>
          <span class="pill">👥 Deudores 6</span>
          ${requiresNewReport ? `<span class="pill warn">📄 Requiere nuevo informe</span>` : ``}
        </div>
        <p class="muted" style="margin-top:10px;">
          Vista ejecutiva: montos del curso (no personales).
        </p>
      </div>

      <div class="card">
        <div class="kTitle">Acciones clave</div>
        <div class="actions" style="margin-top:10px;">
          <button class="btnx primary" onclick="alert('Crear campaña (demo)')">➕ Crear campaña</button>
          <button class="btnx primary" onclick="alert('Generar informe mensual (demo)')">📊 Generar informe</button>
          <button class="btnx" onclick="alert('Cerrar campaña (demo)')">🔒 Cerrar campaña</button>
        </div>
      </div>

      <div class="card">
        <div class="row">
          <div class="kTitle">Rendiciones (visión)</div>
          <div class="actions">
            <button class="btnx" onclick="alert('Ir a rendiciones (demo)')">Ver rendiciones</button>
          </div>
        </div>
        <div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap;">
          <span class="pill danger">⚠️ Gastos sin boleta: 3</span>
          <span class="pill warn">⚠️ Campañas con saldo negativo: 1</span>
        </div>
        <p class="muted" style="margin-top:10px;">
          El presidente puede corregir errores, pero el tesorero opera el día a día.
        </p>
      </div>
    `;
  }

  function renderCampanas(){
    app.innerHTML = `
      <div class="card">
        <div class="kTitle">📌 Campañas activas</div>
        <div style="margin-top:10px;border-top:1px solid #e5e7eb;padding-top:10px;">
          <b>Rifa del curso</b>
          <div class="muted">Recaudado $80.000 · Gastado $65.000 · Saldo $15.000 · Deudores 2</div>
          <div class="actions" style="margin-top:8px;">
            <button class="btnx" onclick="alert('Editar campaña (demo)')">✏️ Editar campaña</button>
          </div>
        </div>

        <div style="margin-top:12px;border-top:1px solid #e5e7eb;padding-top:10px;">
          <b>Paseo de curso</b>
          <div class="muted">Recaudado $40.000 · Gastado $60.000 · Saldo -$20.000 · Deudores 4</div>
          <div class="actions" style="margin-top:8px;">
            <button class="btnx" onclick="alert('Editar campaña (demo)')">✏️ Editar campaña</button>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="kTitle">📘 Campañas cerradas (últimas)</div>
        <p class="muted" style="margin-top:6px;">Aquí se muestran las últimas campañas cerradas y su resultado final.</p>
        <div class="muted" style="margin-top:10px;">(demo) Sin campañas cerradas</div>
      </div>
    `;
  }

  function renderInformes(){
    app.innerHTML = `
      <div class="card">
        <div class="kTitle">📊 Informes</div>
        <p class="muted" style="margin-top:6px;">
          Publica resúmenes del curso a apoderados. Si hubo cambios, emite un nuevo informe.
        </p>
        <div class="actions" style="margin-top:12px;">
          <button class="btnx primary" onclick="alert('Generar informe mensual (demo)')">Generar informe mensual</button>
          <button class="btnx" onclick="alert('Ver historial (demo)')">Ver historial</button>
        </div>

        ${requiresNewReport ? `
          <div style="margin-top:12px;" class="pill warn">📄 Cambios detectados: se recomienda emitir un nuevo informe</div>
        `:``}
      </div>
    `;
  }

  function go(tab){
    nav.forEach(b=>b.classList.remove("active"));
    document.querySelector(`[data-tab="${tab}"]`).classList.add("active");

    if(tab==="home") renderHome();
    if(tab==="campanas") renderCampanas();
    if(tab==="informes") renderInformes();
  }

  nav.forEach(b=>b.onclick=()=>go(b.dataset.tab));
  renderHome();
})();
